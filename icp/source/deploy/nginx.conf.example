# ============================================================
# nginx 站点配置示例（放入已有 nginx 容器的配置外挂目录后 reload）
#
# 假设：
#   - 前端静态文件目录为 /var/www/icp-blog（与 build.sh 的 NGINX_DIST_DIR 一致）
#   - 后端运行在宿主机 8000 端口
#
# 注意：若 nginx 以容器方式运行且非 host 网络模式，
#   proxy_pass 中的 127.0.0.1 指向的是容器自身而非宿主机，
#   请替换为宿主机内网 IP，或使用 host.docker.internal（需配置 extra_hosts）。
# ============================================================
server {
    listen 80;
    server_name your-domain.com;  # TODO: 换成你的域名

    # 前端静态资源
    root /var/www/icp-blog;
    index index.html;

    # 静态资源缓存
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Vue Router history 模式：路由回退到 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 后端 API 反向代理
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

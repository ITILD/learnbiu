{
  "name": "slidev",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "slidev build",
    "build_base": "slidev build --base /learnbiu_python/",
    "dev": "slidev --remote --port 50003",
    "export-pdf": "slidev export --output ./dist_export/slides-export.pdf",
    "export-pptx": "slidev export --format pptx --output ./dist_export/slides-export.pptx --dark",
    "export-png": "slidev export --format png --output ./dist_export/slides-export.png",
    "export-md": "slidev export --format md --output ./dist_export/slides-export.md --timeout 60000"
  },
  "dependencies": {
    "@slidev/cli": "52.14.2",
    "@slidev/theme-default": "latest",
    "@slidev/theme-seriph": "latest",
    "@types/seedrandom": "^3.0.8",
    "seedrandom": "^3.0.5",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "playwright-chromium": "^1.59.1"
  },
  "packageManager": "pnpm@10.34.7+sha512.ba98abc585539933375b5971f4bc6d6c73a1b4b7edc4a879e7d102fe5423d1e02309d67c60a11f04955093a96e521ad9c3b138cdd654ca5be563f378b3ae48bd"
}
